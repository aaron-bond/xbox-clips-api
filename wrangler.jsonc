{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xbox-clips-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Non-secret configuration. XBL_API_KEY is a secret: `wrangler secret put XBL_API_KEY`
  // in production, `.dev.vars` locally. Never add it here - vars are committed in plain text.
  "vars": {
    // Comma-separated: the UI's domain, its Pages hostname and preview deployments, and
    // local UI development. `https://*.host` matches subdomains of host only. Never a bare
    // wildcard: the shared upstream budget is worth protecting from other sites.
    "ALLOWED_ORIGINS": "https://xboxclips.io,https://xbox-clips-ui.pages.dev,https://*.xbox-clips-ui.pages.dev,http://localhost:5173"
  },

  // Namespace "xbox-clips-api-cache". The binding name is what the code uses (env.CACHE).
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "5eaad331b78d4333b50ffe8547d2e2f5"
    }
  ],

  // Per-IP inbound limit protecting the shared upstream budget. Costs no KV writes.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
